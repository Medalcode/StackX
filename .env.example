# Database
DATABASE_URL=sqlite:///./dev.db
# For Docker: postgresql+psycopg2://stackx:stackx_dev@db:5432/stackx

# Docker Compose defaults (override as needed)
POSTGRES_USER=stackx
POSTGRES_PASSWORD=stackx_dev
POSTGRES_DB=stackx

# LLM
OLLAMA_URL=http://localhost:11434/v1/generate
OLLAMA_TIMEOUT=10

# CORS (comma-separated origins, * for development)
CORS_ORIGINS=*

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Admin
ADMIN_TOKEN=your_admin_token_here

# Sanity/GROQ (optional)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_TOKEN=
SYNC_INTERVAL_SECONDS=3600

# Justification skill override (optional)
JUSTIFICATION_SKILL=
